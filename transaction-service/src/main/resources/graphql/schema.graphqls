type Transaction {
    id: ID!
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String
    country: String
    type: String
    createdAt: String
}

type Query {
    transactions: [Transaction]
    transactionsByAccount(accountId: ID!): [Transaction]
}

type Mutation {
    createTransaction(accountId: ID!, amount: Float!, currency: String!, merchantCategory: String, country: String): Transaction
    transfer(fromAccountId: ID!, toAccountId: ID!, amount: Float!, currency: String!): [Transaction]
}
type Account {
    id: ID!
    customerReference: String!
    status: AccountStatus!
    currency: String!
    balance: Float!
}

enum AccountStatus { ACTIVE BLOCKED }

type Query {
    accounts: [Account]
    accountById(id: ID!): Account
}

type Mutation {
    createAccount(customerReference: String!, currency: String!, balance: Float!): Account
    changeAccountStatus(id: ID!, status: AccountStatus!): Account
}